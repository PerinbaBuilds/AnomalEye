# AnomalEye — LLM agent configuration.
# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Without a key, the agent automatically uses the deterministic rule-based
# planner, so the app still runs fully offline.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional overrides (defaults target Groq's OpenAI-compatible endpoint):
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
